# ===== FIREBASE =====
# Récupérer depuis : console.firebase.google.com > Projet > Paramètres > Vos applications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Notifications push web (Cloud Messaging > Web Push certificates dans la console Firebase)
VITE_FIREBASE_VAPID_KEY=
# Anti-bot (App Check > reCAPTCHA v3 > clé de SITE, jamais la clé secrète)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ===== SUPABASE =====
# Récupérer depuis : supabase.com > Projet > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== GEMINI API (optionnel — assistant IA page contact) =====
# Récupérer depuis : aistudio.google.com > Get API Key (gratuit)
VITE_GEMINI_API_KEY=

# ===== DOSSIER MÉDICAL LOCAL (optionnel — démo de soutenance uniquement) =====
# Laisser vide/absent en usage normal ("Mon dossier" reste un placeholder).
# Mettre "local" uniquement sur la machine de soutenance, avec XAMPP actif et
# hospito-dossier-local/ installé — voir son README.
# VITE_DOSSIER_API_MODE=local
# VITE_DOSSIER_API_URL=http://localhost/hospito-dossier-local
